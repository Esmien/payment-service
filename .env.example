# Скопируйте этот файл в .env и заполните значения. Файл .env не должен попадать в git.

# Локальный запуск
# Используются при запуске api/consumer на хосте.
# Замените CHANGE_ME_USER/CHANGE_ME_PASSWORD на свои значения.
DATABASE_URL=postgresql+asyncpg://CHANGE_ME_USER:CHANGE_ME_PASSWORD@localhost:5432/payments
RABBITMQ_URL=amqp://CHANGE_ME_USER:CHANGE_ME_PASSWORD@localhost:5672/


# Обязательно. Дефолта нет: без значения docker compose завершится с ошибкой.
API_KEY=
OUTBOX_POLL_INTERVAL_SECONDS=1.0
OUTBOX_BATCH_SIZE=100
# Настройки ротации сообщений
OUTBOX_RETENTION_DAYS=7
OUTBOX_RETENTION_INTERVAL_SECONDS=3600
WEBHOOK_TIMEOUT_SECONDS=10.0
LOG_LEVEL=INFO


# Обязательные креды. Дефолтов нет: без них docker compose завершится с ошибкой.
POSTGRES_USER=
POSTGRES_PASSWORD=
RABBITMQ_USER=
RABBITMQ_PASSWORD=

POSTGRES_DB=payments
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_HOST_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672


# Порт API на хосте. Внутри контейнера всегда 8000.
API_PORT=8000
